// The website (website/, static files, no build step) on Cloudflare: a Worker that only serves static assets.
// Deploy with: npx wrangler deploy
{
  "name": "getstudio",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "website"
  },
  // Routes on the zone's existing (proxied) DNS records for getstudio.dev and www.
  "routes": [
    { "pattern": "getstudio.dev/*", "zone_name": "getstudio.dev" },
    { "pattern": "www.getstudio.dev/*", "zone_name": "getstudio.dev" }
  ]
}
